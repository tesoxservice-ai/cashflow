# .env.example
# Copiá este archivo como ".env" y completá los valores con los datos
# de tu proyecto en https://supabase.com/dashboard → Settings → API

# URL pública de tu proyecto Supabase
VITE_SUPABASE_URL=

# Clave anónima (anon key) de tu proyecto Supabase
# Esta clave es segura para usar en el frontend; las políticas RLS
# controlan qué datos puede leer/escribir cada usuario.
VITE_SUPABASE_ANON_KEY=
